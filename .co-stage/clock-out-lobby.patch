+function pathPos(s){
+  var p=CONFIG.path;
+  for(var i=0;i<SEG.length;i++){
+    if(s<=SEG[i]||i===SEG.length-1){
+      var t=clamp(s/SEG[i],0,1);
+      return [p[i][0]+(p[i+1][0]-p[i][0])*t, p[i][1]+(p[i+1][1]-p[i][1])*t];
