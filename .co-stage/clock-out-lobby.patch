+function makeEnemy(type,s){
+  var d=ENEMIES[type];
+  return {type:type,s:s,hp:d.hp,maxHp:d.hp,slow:0,used:false,bt:0,flash:0,fcd:0,dying:0};
+}
+function enemyPos(e){return pathPos(e.s);}
