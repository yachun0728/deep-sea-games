+    for(i=0;i<it.cells.length;i++) ctx.fillRect(CONFIG.ox+it.cells[i][0]*CONFIG.cell+2,CONFIG.oy+it.cells[i][1]*CONFIG.cell+2,CONFIG.cell-4,CONFIG.cell-4);
